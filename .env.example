# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Storage Engine Selection ("sqlite" | "supabase" | "local")
# sqlite   - Embedded SQLite database in data/app.db (Default, zero setup, ACID)
# supabase - Cloud PostgreSQL via SQLAlchemy or Supabase REST API (Permanent across Render redeploys)
# local    - Local JSON and CSV files (data/api_keys.json, reference/categories.json)
STORAGE_TYPE=sqlite

# Direct Database URL for SQLAlchemy (Creates tables dynamically on startup)
# For Supabase/Postgres: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Supabase REST Credentials (Alternative if DATABASE_URL is not used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional Default Target Portal
DEFAULT_TARGET_PORTAL_URL=

# Note: Gemini API keys are dynamically managed via the Dashboard Key Pool Manager
# and stored securely with Round-Robin load balancing.
GEMINI_API_KEY=
