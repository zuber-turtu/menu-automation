# Set default behavior to automatically normalize line endings
* text=auto

# Source code
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files (prevent Git from corrupting Excel sheets and images)
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
